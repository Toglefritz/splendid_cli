<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.splendidcli.intellij</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>Splendid CLI Tools</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="support@splendidcli.com" url="https://github.com/yourusername/splendid_cli">Splendid CLI</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
    Integrates Splendid CLI utilities into Android Studio and IntelliJ IDEA for Flutter development workflows.
    <br><br>
    <strong>Features:</strong>
    <ul>
      <li>Sort localizable strings in .arb files alphabetically</li>
      <li>Sort enum values alphabetically in .dart files</li>
      <li>Format Dartdoc comments to 80 or 120 character line lengths</li>
      <li>Fully format Dart files (comments and code)</li>
      <li>More features coming soon...</li>
    </ul>
    <br>
    <strong>Requirements:</strong>
    <ul>
      <li>Splendid CLI must be installed and available in your system PATH</li>
      <li>Flutter/Dart plugin must be installed</li>
    </ul>
  ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>Dart</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Project-level service for executing CLI commands -->
        <projectService serviceImplementation="com.splendidcli.intellij.services.CliExecutorService"/>
        
        <!-- Settings/Preferences page -->
        <projectConfigurable 
            parentId="tools" 
            instance="com.splendidcli.intellij.settings.PluginSettingsConfigurable"
            id="com.splendidcli.intellij.settings.PluginSettingsConfigurable"
            displayName="Splendid CLI Tools"/>
        
        <!-- Notification group for plugin messages -->
        <notificationGroup id="Splendid CLI Notifications" displayType="BALLOON"/>
    </extensions>

    <!-- Actions -->
    <actions>
        <!-- Splendid CLI Tools submenu in Tools menu -->
        <group id="SplendidCli.ToolsMenu"
               text="Splendid CLI"
               description="Splendid CLI development tools"
               popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>

        <!-- Sort L10n action for .arb files -->
        <action id="SplendidCli.SortL10n"
                class="com.splendidcli.intellij.actions.SortL10nAction"
                text="Sort Localizable Strings"
                description="Sort ARB file entries alphabetically using Splendid CLI">
            <!-- Add to Splendid CLI submenu in Tools menu -->
            <add-to-group group-id="SplendidCli.ToolsMenu" anchor="first"/>
            <!-- Add to editor popup menu (right-click in editor) -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <!-- Add to project view popup menu (right-click on file in tree) -->
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <!-- Sort Enum Values action for .dart files -->
        <action id="SplendidCli.SortEnum"
                class="com.splendidcli.intellij.actions.SortEnumAction"
                text="Sort Enum Values"
                description="Sort enum values alphabetically in Dart files using Splendid CLI">
            <!-- Add to Splendid CLI submenu in Tools menu -->
            <add-to-group group-id="SplendidCli.ToolsMenu" anchor="after" relative-to-action="SplendidCli.SortL10n"/>
            <!-- Add to editor popup menu (right-click in editor) -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <!-- Add to project view popup menu (right-click on file in tree) -->
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <!-- Format Dartdoc to 80 characters action for .dart files -->
        <action id="SplendidCli.FormatDartdoc80"
                class="com.splendidcli.intellij.actions.FormatDartdoc80Action"
                text="Format Dartdoc Comments (80 chars)"
                description="Format Dartdoc comments to 80 character line length using Splendid CLI">
            <!-- Add to Splendid CLI submenu in Tools menu -->
            <add-to-group group-id="SplendidCli.ToolsMenu" anchor="after" relative-to-action="SplendidCli.SortEnum"/>
            <!-- Add to editor popup menu (right-click in editor) -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <!-- Add to project view popup menu (right-click on file in tree) -->
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <!-- Format Dartdoc to 120 characters action for .dart files -->
        <action id="SplendidCli.FormatDartdoc120"
                class="com.splendidcli.intellij.actions.FormatDartdoc120Action"
                text="Format Dartdoc Comments (120 chars)"
                description="Format Dartdoc comments to 120 character line length using Splendid CLI">
            <!-- Add to Splendid CLI submenu in Tools menu -->
            <add-to-group group-id="SplendidCli.ToolsMenu" anchor="after" relative-to-action="SplendidCli.FormatDartdoc80"/>
            <!-- Add to editor popup menu (right-click in editor) -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <!-- Add to project view popup menu (right-click on file in tree) -->
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <!-- Format regular comments to 80 characters action for .dart files -->
        <action id="SplendidCli.FormatComments80"
                class="com.splendidcli.intellij.actions.FormatComments80Action"
                text="Format Regular Comments (80 chars)"
                description="Format regular // comments to 80 character line length using Splendid CLI">
            <!-- Add to Splendid CLI submenu in Tools menu -->
            <add-to-group group-id="SplendidCli.ToolsMenu" anchor="after" relative-to-action="SplendidCli.FormatDartdoc120"/>
            <!-- Add to editor popup menu (right-click in editor) -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <!-- Add to project view popup menu (right-click on file in tree) -->
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <!-- Format regular comments to 120 characters action for .dart files -->
        <action id="SplendidCli.FormatComments120"
                class="com.splendidcli.intellij.actions.FormatComments120Action"
                text="Format Regular Comments (120 chars)"
                description="Format regular // comments to 120 character line length using Splendid CLI">
            <!-- Add to Splendid CLI submenu in Tools menu -->
            <add-to-group group-id="SplendidCli.ToolsMenu" anchor="after" relative-to-action="SplendidCli.FormatComments80"/>
            <!-- Add to editor popup menu (right-click in editor) -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <!-- Add to project view popup menu (right-click on file in tree) -->
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <!-- Format Dart file action (comprehensive formatting) -->
        <action id="SplendidCli.FormatDartFile80"
                class="com.splendidcli.intellij.actions.FormatDartFile80Action"
                text="Format Dart File (80 chars)"
                description="Fully format Dart file including Dartdoc comments, regular comments, and code to 80 character line length using Splendid CLI">
            <!-- Add to Splendid CLI submenu in Tools menu -->
            <add-to-group group-id="SplendidCli.ToolsMenu" anchor="after" relative-to-action="SplendidCli.FormatComments120"/>
            <!-- Add to editor popup menu (right-click in editor) -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <!-- Add to project view popup menu (right-click on file in tree) -->
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <!-- Format Dart file action (comprehensive formatting) -->
        <action id="SplendidCli.FormatDartFile120"
                class="com.splendidcli.intellij.actions.FormatDartFile120Action"
                text="Format Dart File (120 chars)"
                description="Fully format Dart file including Dartdoc comments, regular comments, and code to 120 character line length using Splendid CLI">
            <!-- Add to Splendid CLI submenu in Tools menu -->
            <add-to-group group-id="SplendidCli.ToolsMenu" anchor="after" relative-to-action="SplendidCli.FormatDartFile80"/>
            <!-- Add to editor popup menu (right-click in editor) -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <!-- Add to project view popup menu (right-click on file in tree) -->
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <!-- Create Flutter screen action for directories -->
        <action id="SplendidCli.CreateScreen"
                class="com.splendidcli.intellij.actions.CreateScreenAction"
                text="New Flutter Screen..."
                description="Create a new Flutter screen with MVC architecture using Splendid CLI">
            <!-- Add to Splendid CLI submenu in Tools menu -->
            <add-to-group group-id="SplendidCli.ToolsMenu" anchor="after" relative-to-action="SplendidCli.FormatDartFile120"/>
        </action>
    </actions>
</idea-plugin>
